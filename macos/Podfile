platform :osx, '14.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    # flutter_zxing resolves its FFI symbols at runtime via
    # DynamicLibrary.process(); with static linkage the linker dead-strips
    # the unreferenced archive, so build it dynamic to keep symbols exported.
    if target.name == 'flutter_zxing'
      target.build_configurations.each do |config|
        config.build_settings['MACH_O_TYPE'] = 'mh_dylib'
      end
    end
    target.build_configurations.each do |config|
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      # Xcode 27 rejects deployment targets below 12.0; plugin podspecs still
      # declare 10.13-10.15 minimums, so force an accepted floor on every pod.
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
      # Workaround for Xcode 26 "Explicitly Built Modules" regression that breaks
      # resolution of static-framework plugin modules during Archive.
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
  end
end

post_integrate do |installer|
  # With static linkage CocoaPods omits the embed call for flutter_zxing
  # (built dynamic above); (re)append it so the framework lands in the bundle.
  sh_path = File.join(
    installer.sandbox.target_support_files_root.to_s,
    'Pods-Runner',
    'Pods-Runner-frameworks.sh',
  )
  if File.exist?(sh_path)
    content = File.read(sh_path)
    unless content.include?('flutter_zxing.framework')
      File.write(
        sh_path,
        content + "\ninstall_framework \"flutter_zxing/flutter_zxing.framework\"\n",
      )
    end
  end
end
