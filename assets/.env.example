# AI Assistant API keys — all providers below are FREE.
# Copy this file to .env and fill in the keys for the providers you want.
# Models whose keys are empty will be hidden from the selector automatically.

# z.ai (GLM Flash — FREE & unlimited): https://z.ai/
ZAI_API_KEY=

# Mistral AI (Mistral Small/Medium — permanent free tier, supports tools): https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenRouter (Nemotron etc. — free models): https://openrouter.ai/
OPENROUTER_API_KEY=
